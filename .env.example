# proof-feed — environment template. Copy to .env (never commit .env).

## Creditcoin CC3 Testnet (chainId 102031)
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
CREDITCOIN_EXPLORER_URL="https://creditcoin-testnet.blockscout.com"
CREDITCOIN_WALLET_PRIVATE_KEY=""            # 0x… 66 chars; fund from the testnet faucet

## Attestcoin prover (Day-1 spike picks the live host; see docs/05 §2)
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL_ALT="https://proof-gen-api.cc3-testnet.creditcoin.network"

## Source chain
SOURCE_CHAIN_KEY=3                            # 3 = Ethereum mainnet on CC3 testnet, 1 = Sepolia
ETH_MAINNET_RPC_URL="https://gateway.tenderly.co/public/mainnet"   # Day-1 verified: serves 20k-block eth_getLogs.
                                              # Do NOT use publicnode: it 403s on eth_getLogs (docs/05 4b).
ETH_SEPOLIA_RPC_URL=""                        # Branch S only

## Chainlink proxies (Ethereum mainnet) — aggregators are read from these at runtime, never typed by hand
FEED_PROXY_USDC_USD="0x8fFfFfd4AfB6115b954Bd326cbe7B4BA576818f6"
FEED_PROXY_ETH_USD="0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419"

## Deployed contracts (filled by the deploy script / docs/DEPLOYMENT.md)
PROBE_ADDRESS=""
REGISTRY_ADDRESS=""
ADAPTER_ADDRESS=""
PEGGUARD_ADDRESS=""

## Deploy script inputs (script/Deploy.s.sol)
OWNER=""
FEED_DESCRIPTION="USDC / USD"                 # exact string from proxy.description()
FEED_CHAIN_KEY=3
FEED_EMITTER=""                               # proxy.aggregator() — printed by `pf register --dry-run`
FEED_PHASE_ID=""                              # proxy.phaseId()
FEED_DECIMALS=8

## CLI
LOG_LEVEL="info"
